# SQLite (desenvolvimento). Para PostgreSQL: DATABASE_URL=postgresql://user:senha@host:5432/flagtrack
# e altere provider = "postgresql" em prisma/schema.prisma
DATABASE_URL=file:./dev.db
# Obrigatórios em produção (gerados automaticamente em desenvolvimento):
JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
PORT=3001
