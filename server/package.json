{
  "name": "@flagtrack/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "cross-env NODE_ENV=production tsx src/index.ts",
    "db:push": "node scripts/ensure-env.mjs && prisma db push --skip-generate && prisma generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flagtrack/shared": "1.0.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cross-env": "7.0.3",
    "dotenv": "16.4.5",
    "exceljs": "4.4.0",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "luxon": "3.5.0",
    "pdfkit": "0.15.1",
    "tsx": "4.19.2",
    "web-push": "3.6.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/luxon": "3.4.2",
    "@types/node": "20.17.6",
    "@types/pdfkit": "0.13.5",
    "@types/supertest": "6.0.2",
    "@types/web-push": "3.6.4",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "vitest": "2.1.8"
  }
}
